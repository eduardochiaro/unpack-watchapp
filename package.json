{
  "name": "unpack-watchapp",
  "author": "MakeAwesomeHappen",
  "version": "1.0.0",
  "keywords": [
    "pebble-app"
  ],
  "scripts": {
    "build": "pebble clean && pebble build",
    "emulator": "npm run build && pebble install --emulator ",
    "phone": "npm run build && pebble install --phone",
    "config": "pebble emu-app-config --emulator",
    "screenshot": "./scripts/screenshot.sh",
    "logs": "pebble logs",
    "cleanup": "npm run lint && npm run format",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write src/**/*.js test/**/*.js"
  },
  "private": true,
  "dependencies": {},
