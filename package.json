{
  "name": "unpack-watchapp",
  "author": "MakeAwesomeHappen",
  "version": "1.0.0",
  "keywords": [
    "pebble-app"
  ],
  "scripts": {
    "build": "pebble clean && pebble build",
    "emulator": "npm run build && pebble install --emulator ",
    "phone": "npm run build && pebble install --phone",
    "config": "pebble emu-app-config --emulator",
    "screenshot": "./scripts/screenshot.sh",
    "logs": "pebble logs",
    "cleanup": "npm run lint && npm run format",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write src/**/*.js test/**/*.js"
  },
  "private": true,
  "dependencies": {},
  "pebble": {
    "displayName": "Unpack",
    "uuid": "bd9bfa05-1c15-4f30-af62-24f803e277c2",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "aplite",
      "basalt",
      "chalk",
      "diorite",
      "emery",
      "flint",
      "gabbro"
    ],
    "watchapp": {
      "watchface": false
    },
    "messageKeys": [
      "dummy"
    ],
    "resources": {
      "media": [
        {
          "menuIcon": "true",
          "type": "png",
          "name": "MENU_ICON",
          "file": "menu_icon.png"
        },
        {
          "type": "bitmap",
          "name": "SPLASH",
          "file": "splash-basalt.png",
          "targetPlatforms": [
            "aplite",
            "basalt",
            "chalk",
            "diorite",
            "flint"
          ]
        },
        {
          "type": "bitmap",
          "name": "SPLASH",
          "file": "splash-emery.png",
          "targetPlatforms": [
            "emery",
            "gabbro"
          ]
        },
        {
          "type": "raw",
          "name": "GUIDE",
          "file": "guide.txt"
        }
      ]
    }
  }
}
